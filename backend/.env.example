# ============================================
# AI Trading Agent - Environment Configuration
# ============================================
# Copy file ini ke .env dan isi dengan values Anda
# cp .env.example .env

# ============================================
# BINANCE API (Phase 1: Data Collection)
# ============================================
# Dapatkan API keys dari: https://testnet.binance.vision/
# (Testnet aman untuk testing, tidak pakai uang asli)

BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_secret

# ============================================
# NEWS APIs (Phase G: Advanced AI)
# ============================================
# CryptoPanic (GRATIS, khusus crypto - PALING DIREKOMENDASIKAN)
# Daftar: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# NewsAPI.org (Freemium, 100 requests/hari gratis)
# Daftar: https://newsapi.org/
NEWSAPI_API_KEY=

# GNews (Gratis, 100 requests/hari)
# Daftar: https://gnews.org/
GNEWS_API_KEY=

# ============================================
# TWITTER/X API (Phase G: Advanced AI)
# ============================================
# Twitter API v2 (berbayar, $100/bulan untuk Basic)
# Daftar: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ============================================
# REDDIT API (Phase G: Advanced AI - GRATIS)
# ============================================
# Daftar: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ============================================
# TELEGRAM API (Phase G: Advanced AI)
# ============================================
# Daftar: https://my.telegram.org/
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ============================================
# ADVANCED AI SETTINGS
# ============================================
# FinBERT Model (pilih salah satu):
# - yiyanghkust/finbert-tone (recommended)
# - ProsusAI/finbert
# - ahmedrachid/FinancialBERT-Sentiment-Analysis
FINBERT_MODEL=yiyanghkust/finbert-tone

# GPU Usage (true/false)
# Set true jika punya GPU untuk faster inference
USE_GPU=false

# Model cache directory
MODEL_CACHE_DIR=./models_cache

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/Disable features
ENABLE_FINBERT=true
ENABLE_TWITTER=true
ENABLE_REDDIT=false
ENABLE_TELEGRAM=false
ENABLE_CACHE=true

# ============================================
# CACHING SETTINGS
# ============================================
# Cache TTL (seconds)
CACHE_TTL_NEWS=300
CACHE_TTL_TWITTER=60
CACHE_TTL_SENTIMENT=180
CACHE_TTL_REDDIT=300

# ============================================
# PUMP & DUMP DETECTION
# ============================================
# Thresholds untuk deteksi pump & dump
PUMP_VOLUME_THRESHOLD=3.0
PUMP_PRICE_1H_THRESHOLD=15.0
PUMP_PRICE_24H_THRESHOLD=30.0
PUMP_SOCIAL_THRESHOLD=5.0
PUMP_MIN_MENTIONS=50

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
ADVANCED_AI_LOG_LEVEL=INFO
