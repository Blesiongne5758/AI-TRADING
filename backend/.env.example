# ============================================
# AI Trading Agent - Environment Configuration
# ============================================
# Copy file ini ke .env dan isi dengan values Anda
# cp .env.example .env

# ============================================
# BINANCE API (Phase 1: Data Collection)
# ============================================
# Dapatkan API keys dari: https://testnet.binance.vision/
# (Testnet aman untuk testing, tidak pakai uang asli)

BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_secret

# ============================================
# FINBERT (Phase G: Advanced AI)
# ============================================
# FinBERT tidak perlu API key, model akan di-download otomatis
# First run akan download ~400MB model

# GPU Usage (true/false)
# Set true jika punya GPU untuk faster inference (5-7x speedup)
USE_GPU=false

# Model cache directory
# Model akan di-cache di directory ini untuk faster loading
MODEL_CACHE_DIR=./models_cache

# ============================================
# NEWS APIs (Phase G: Advanced AI)
# ============================================

# CryptoPanic (GRATIS, khusus crypto - PALING DIREKOMENDASIKAN)
# Daftar: https://cryptopanic.com/developers/api/
# Rate limit: 30 requests/minute (free tier)
CRYPTOPANIC_API_KEY=your_cryptopanic_key

# NewsAPI.org (Freemium, general news)
# Daftar: https://newsapi.org/
# Rate limit: 100 requests/day (free tier)
NEWSAPI_API_KEY=your_newsapi_key

# GNews (GRATIS, alternative news source)
# Daftar: https://gnews.org/
# Rate limit: 100 requests/day (free tier)
GNEWS_API_KEY=your_gnews_key

# ============================================
# TWITTER/X (Phase G: Advanced AI - OPTIONAL)
# ============================================
# Twitter API v2 (BERBAYAR, $100/bulan untuk Basic tier)
# Daftar: https://developer.twitter.com/
# Rate limit: 300 requests/15 minutes

# Jika tidak punya budget, gunakan Nitter (GRATIS, no API key needed)
# Nitter instances sudah di-configure di config.py
TWITTER_BEARER_TOKEN=

# ============================================
# REDDIT (Phase G: Advanced AI - GRATIS)
# ============================================
# Daftar: https://www.reddit.com/prefs/apps
# 1. Login ke Reddit
# 2. Go to https://www.reddit.com/prefs/apps
# 3. Click "create another app..."
# 4. Select "script"
# 5. Fill form dan submit
# 6. Copy client_id dan client_secret
# Rate limit: 60 requests/minute

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ============================================
# TELEGRAM (Phase G: Advanced AI - OPTIONAL)
# ============================================
# Daftar: https://my.telegram.org/
# 1. Login dengan phone number
# 2. Go to "API development tools"
# 3. Create application
# 4. Copy API ID dan API Hash

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/Disable features
# Set false untuk disable feature yang tidak digunakan

ENABLE_FINBERT=true           # FinBERT sentiment analysis
ENABLE_TWITTER=false          # Twitter/X API (berbayar)
ENABLE_REDDIT=false           # Reddit API (gratis)
ENABLE_TELEGRAM=false         # Telegram API (optional)
ENABLE_CACHE=true             # Caching system (recommended)

# ============================================
# CACHING SETTINGS
# ============================================
# Cache TTL (Time To Live) dalam detik
# Longer TTL = fewer API calls, tapi data less fresh

CACHE_TTL_NEWS=300            # 5 minutes untuk news
CACHE_TTL_TWITTER=60          # 1 minute untuk tweets
CACHE_TTL_SENTIMENT=180       # 3 minutes untuk sentiment
CACHE_TTL_REDDIT=300          # 5 minutes untuk reddit posts

# ============================================
# PUMP & DUMP DETECTION
# ============================================
# Thresholds untuk deteksi pump & dump
# Adjust berdasarkan market conditions

# Volume spike threshold (x rata-rata)
# 3.0 = volume 3x lebih tinggi dari average
PUMP_VOLUME_THRESHOLD=3.0

# Price spike dalam 1 jam (%)
# 15.0 = price naik/turun 15% dalam 1 jam
PUMP_PRICE_1H_THRESHOLD=15.0

# Price spike dalam 24 jam (%)
# 30.0 = price naik/turun 30% dalam 24 jam
PUMP_PRICE_24H_THRESHOLD=30.0

# Social mention spike (x rata-rata)
# 5.0 = mentions 5x lebih tinggi dari average
PUMP_SOCIAL_THRESHOLD=5.0

# Minimum social mentions untuk validasi
# 50 = butuh minimal 50 mentions untuk consider pump
PUMP_MIN_MENTIONS=50

# ============================================
# LOGGING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
ADVANCED_AI_LOG_LEVEL=INFO

# ============================================
# NOTES
# ============================================
# 1. API Keys:
#    - Jangan commit .env ke git!
#    - Gunakan .env.example sebagai template
#    - Get API keys dari links di atas
#
# 2. FinBERT:
#    - Tidak perlu API key
#    - Model akan auto-download saat first run
#    - Size: ~400MB
#    - Use GPU untuk faster inference (optional)
#
# 3. Twitter:
#    - API berbayar ($100/month)
#    - Alternative: Nitter (gratis, no API key)
#    - Nitter instances sudah di-configure
#
# 4. Reddit:
#    - GRATIS dengan OAuth
#    - Daftar di reddit.com/prefs/apps
#    - Rate limit: 60 req/min
#
# 5. Cache:
#    - Enabled by default (recommended)
#    - Reduce API calls by 80%
#    - Faster response times
#    - Cache stored in ./cache/
#
# 6. Testing:
#    - Run: python -m advanced_ai.main_advanced_ai
#    - Test all components
#    - Check logs untuk debugging
