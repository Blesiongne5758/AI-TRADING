# ============================================
# AI Trading Agent - Environment Configuration
# ============================================
# Copy file ini ke .env dan isi dengan values Anda
# cp .env.example .env

# ============================================
# BINANCE API SETTINGS
# ============================================
# Langkah mendapatkan API keys Testnet:
# 1. Buka https://testnet.binance.vision/
# 2. Login dengan akun GitHub
# 3. Klik "Log In With GitHub"
# 4. Setelah login, klik "Generate HMAC_SHA256 Key"
# 5. Copy API Key dan Secret Key ke bawah ini

BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_secret

# Note: USE_TESTNET sudah di-set True di config.py
# Testnet menggunakan uang virtual, aman untuk testing
# Ubah ke False HANYA jika Anda yakin untuk production (uang asli!)
