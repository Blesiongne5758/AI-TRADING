# ============================================
# AI Trading Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=AI Trading Agent
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# BINANCE API SETTINGS
# ============================================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# For testing, use testnet: https://testnet.binance.vision/

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# Trading symbols (comma-separated)
TRADING_SYMBOLS=["BTC/USDT","ETH/USDT","SOL/USDT","BNB/USDT","XRP/USDT"]

# Timeframes for analysis (comma-separated)
TIMEFRAMES=["1m","5m","15m","1h","4h","1d"]

# ============================================
# DATABASE SETTINGS
# ============================================
DATABASE_URL=sqlite+aiosqlite:///./database/trading_data.db

# ============================================
# TELEGRAM BOT SETTINGS
# ============================================
# Create a bot via @BotFather on Telegram
# Get your chat ID via @userinfobot

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# TRADING SETTINGS
# ============================================
PAPER_TRADING=true
INITIAL_BALANCE=10000.0

# Risk management (0.02 = 2%)
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=5
STOP_LOSS_PERCENT=0.02
TAKE_PROFIT_PERCENT=0.05

# Signal threshold (0.60 = 60%)
MIN_CONFIDENCE_THRESHOLD=0.60

# ============================================
# ANALYSIS SETTINGS
# ============================================
# Technical indicators
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
EMA_PERIODS=[20,50,200]
BOLLINGER_PERIOD=20
BOLLINGER_STD=2

# Sentiment analysis
SENTIMENT_MODEL=ProsusAI/finbert

# News sources (comma-separated RSS feeds)
NEWS_SOURCES=["https://cointelegraph.com/rss","https://www.coindesk.com/arc/outboundfeeds/rss/","https://cryptonews.com/news/feed/"]

# News fetch interval (seconds)
NEWS_FETCH_INTERVAL=900

# ============================================
# API SETTINGS
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
