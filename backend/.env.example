# ============================================
# AI Trading Agent - Environment Configuration
# ============================================
# Copy file ini ke .env dan isi dengan values Anda
# cp .env.example .env

# ============================================
# BINANCE API SETTINGS
# ============================================
# Dapatkan API keys dari: https://testnet.binance.vision/
# (Testnet aman untuk testing, tidak pakai uang asli)

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Note: USE_TESTNET sudah di-set True di config.py
# Ubah ke False hanya jika Anda yakin untuk production
